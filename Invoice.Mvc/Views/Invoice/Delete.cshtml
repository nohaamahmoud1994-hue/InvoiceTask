@using Invoice.Core.Models
@model Invoices

@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="text-danger fw-bold mb-1">
                Delete Invoice
            </h3>

            <p class="text-muted mb-0">
                Please confirm that you want to delete this invoice.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Invoices
        </a>

    </div>


    <!-- Warning -->

    <div class="alert alert-warning d-flex align-items-center mb-4">

        <div>
            <strong>Warning!</strong>
            This action cannot be undone.
        </div>

    </div>


    <!-- Invoice Summary -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-light">

            <h5 class="mb-0 fw-bold text-primary">
                Invoice Information
            </h5>

        </div>


        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">

                    <label class="text-muted small">
                        Internal ID
                    </label>

                    <div class="fw-semibold">
                        @Model.InternalId
                    </div>

                </div>


                <div class="col-md-4">

                    <label class="text-muted small">
                        Document Type
                    </label>

                    <div class="fw-semibold">
                        @Model.DocumentType
                    </div>

                </div>


                <div class="col-md-4">

                    <label class="text-muted small">
                        Version
                    </label>

                    <div class="fw-semibold">
                        @Model.DocumentTypeVersion
                    </div>

                </div>


                <div class="col-md-6">

                    <label class="text-muted small">
                        Issuer
                    </label>

                    <div class="fw-semibold">
                        @Model.Issuer?.Name
                    </div>

                </div>


                <div class="col-md-6">

                    <label class="text-muted small">
                        Receiver
                    </label>

                    <div class="fw-semibold">
                        @Model.Receiver?.Name
                    </div>

                </div>


                <div class="col-md-4">

                    <label class="text-muted small">
                        Taxpayer Activity Code
                    </label>

                    <div class="fw-semibold">
                        @Model.TaxpayerActivityCode
                    </div>

                </div>


                <div class="col-md-4">

                    <label class="text-muted small">
                        Invoice Lines
                    </label>

                    <div class="fw-semibold">
                        @(Model.InvoiceLines?.Count ?? 0)
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Delete Form -->

    <form asp-action="Delete"
          method="post"
          class="mt-4">

        <input type="hidden"
               asp-for="Id" />


        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary px-4">
                Cancel
            </a>


            <button type="submit"
                    class="btn btn-danger px-4">

                Delete Invoice

            </button>

        </div>

    </form>

</div>