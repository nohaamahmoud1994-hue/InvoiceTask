@using Invoice.Core.Models
@model Invoices

@{
    ViewData["Title"] = "Create Invoice";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-receipt me-2"></i>
                Create Invoice
            </h2>

            <p class="text-muted mb-0">
                Enter invoice information and create a new invoice.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Invoices

        </a>

    </div>


    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>


    <!-- Invoice Card -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- Tabs -->
                <ul class="nav nav-tabs mb-4"
                    id="invoiceTabs"
                    role="tablist">

                    <li class="nav-item"
                        role="presentation">

                        <button class="nav-link active"
                                id="invoice-info-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#invoice-info"
                                type="button"
                                role="tab">

                            <i class="bi bi-file-text me-1"></i>
                            Invoice Info

                        </button>

                    </li>


                    <li class="nav-item"
                        role="presentation">

                        <button class="nav-link"
                                id="issuer-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#issuer"
                                type="button"
                                role="tab">

                            <i class="bi bi-building me-1"></i>
                            Issuer

                        </button>

                    </li>


                    <li class="nav-item"
                        role="presentation">

                        <button class="nav-link"
                                id="receiver-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#receiver"
                                type="button"
                                role="tab">

                            <i class="bi bi-person me-1"></i>
                            Receiver

                        </button>

                    </li>


                    <li class="nav-item"
                        role="presentation">

                        <button class="nav-link"
                                id="lines-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#lines"
                                type="button"
                                role="tab">

                            <i class="bi bi-list-ul me-1"></i>
                            Invoice Lines

                        </button>

                    </li>

                </ul>


                <!-- Tab Content -->

                <div class="tab-content">


                    <!-- Invoice Info -->

                    <div class="tab-pane fade show active"
                         id="invoice-info"
                         role="tabpanel">

                        <partial name="_InvoiceInfo"
                                 model="Model" />

                    </div>


                    <!-- Issuer -->

                    <div class="tab-pane fade"
                         id="issuer"
                         role="tabpanel">

                        <partial name="_Issuer"
                                 model="Model" />

                    </div>


                    <!-- Receiver -->

                    <div class="tab-pane fade"
                         id="receiver"
                         role="tabpanel">

                        <partial name="_Receiver"
                                 model="Model" />

                    </div>


                    <!-- Invoice Lines -->

                    <div class="tab-pane fade"
                         id="lines"
                         role="tabpanel">

                        <partial name="_InvoiceLine"
                                 model="Model" />

                    </div>

                </div>


                <!-- Footer Buttons -->

                <div class="border-top mt-4 pt-4">

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-x-lg me-1"></i>
                            Cancel

                        </a>


                        <button type="submit"
                                class="btn btn-primary px-4">

                            <i class="bi bi-check-lg me-1"></i>
                            Create Invoice

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const firstError =
                document.querySelector(
                    '.field-validation-error, .input-validation-error'
                );

            if (firstError) {

                const tabPane =
                    firstError.closest('.tab-pane');

                if (tabPane) {

                    const tabId =
                        tabPane.getAttribute('id');

                    const tabButton =
                        document.querySelector(
                            `#invoiceTabs button[data-bs-target="#${tabId}"]`
                        );

                    if (tabButton) {

                        const bsTab =
                            new bootstrap.Tab(tabButton);

                        bsTab.show();

                    }
                }
            }

        });

    </script>
}