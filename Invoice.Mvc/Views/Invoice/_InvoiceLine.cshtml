@using Invoice.Core.Models
@model Invoices

<style>
    .invoice-line {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .invoice-line-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid #dee2e6;
    }

    .invoice-line-title {
        font-size: 16px;
        font-weight: 600;
        color: #0d6efd;
        margin: 0;
    }

    .sub-section {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 16px;
        margin-top: 18px;
    }

    .sub-section-title {
        color: #0d6efd;
        font-weight: 600;
        font-size: 15px;
        margin-bottom: 15px;
    }

    .form-label {
        font-weight: 500;
        margin-bottom: 6px;
    }

    .remove-line {
        min-width: 120px;
    }

    .remove-tax {
        margin-bottom: 21px;
    }

    .tax-row {
        background: #f8f9fa;
        border: 1px solid #e1e1e1;
        border-radius: 7px;
        padding: 12px;
        margin-bottom: 12px;
    }

    .add-line-btn {
        min-width: 170px;
    }

    .add-tax-btn {
        min-width: 105px;
    }

    .readonly-field {
        background-color: #e9ecef;
        cursor: not-allowed;
    }
</style>


<!-- Section Header -->
<div class="section-header mb-3">
    <h5 class="text-primary fw-bold">Invoice Lines</h5>
    <hr />
</div>


<div id="invoiceLinesContainer">

    @if (Model?.InvoiceLines != null && Model.InvoiceLines.Any())
    {
        for (int i = 0; i < Model.InvoiceLines.Count; i++)
        {
            <div class="invoice-line">

                <!-- Line Header -->
                <div class="invoice-line-header">

                    <h6 class="invoice-line-title">
                        <i class="bi bi-receipt me-2"></i>
                        Invoice Line @(i + 1)
                    </h6>

                    <button type="button"
                            class="btn btn-sm btn-outline-danger remove-line">

                        <i class="bi bi-trash me-1"></i>
                        Remove Line

                    </button>

                </div>


                <!-- Basic Information -->
                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Description
                        </label>

                        <input name="InvoiceLines[@i].Description"
                               value="@Model.InvoiceLines[i].Description"
                               class="form-control"
                               required />

                        <span asp-validation-for="@Model.InvoiceLines[i].Description"
                              class="text-danger"></span>

                    </div>


                    <div class="col-md-3">

                        <label class="form-label">
                            Item Type
                        </label>

                        <select name="InvoiceLines[@i].ItemType"
                                class="form-select">

                            <option value="EGS"
                                    selected="@(Model.InvoiceLines[i].ItemType == "EGS")">
                                EGS
                            </option>

                            <option value="GS1"
                                    selected="@(Model.InvoiceLines[i].ItemType == "GS1")">
                                GS1
                            </option>

                        </select>

                    </div>


                    <div class="col-md-3">

                        <label class="form-label">
                            Item Code
                        </label>

                        <input name="InvoiceLines[@i].ItemCode"
                               value="@Model.InvoiceLines[i].ItemCode"
                               class="form-control"
                               required />

                        <span asp-validation-for="@Model.InvoiceLines[i].ItemCode"
                              class="text-danger"></span>

                    </div>


                    <div class="col-md-3">

                        <label class="form-label">
                            Unit Type
                        </label>

                        <input name="InvoiceLines[@i].UnitType"
                               value="@Model.InvoiceLines[i].UnitType"
                               class="form-control"
                               required />

                        <span asp-validation-for="@Model.InvoiceLines[i].UnitType"
                              class="text-danger"></span>

                    </div>


                    <div class="col-md-3">

                        <label class="form-label">
                            Quantity
                        </label>

                        <input name="InvoiceLines[@i].Quantity"
                               value="@Model.InvoiceLines[i].Quantity"
                               class="form-control quantity"
                               type="number"
                               step="0.00001"
                               min="0"
                               required />

                        <span asp-validation-for="@Model.InvoiceLines[i].Quantity"
                              class="text-danger"></span>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Internal Code
                            <span class="text-muted">(Optional)</span>
                        </label>

                        <input name="InvoiceLines[@i].InternalCode"
                               value="@Model.InvoiceLines[i].InternalCode"
                               class="form-control" />

                    </div>

                </div>


                <!-- Unit Value -->
                <div class="sub-section">

                    <h6 class="sub-section-title">
                        <i class="bi bi-currency-exchange me-2"></i>
                        Unit Value Details
                    </h6>

                    <div class="row g-3">

                        <div class="col-md-3">

                            <label class="form-label">
                                Currency Sold
                            </label>

                            <input name="InvoiceLines[@i].UnitValue.CurrencySold"
                                   value="@(Model.InvoiceLines[i].UnitValue?.CurrencySold ?? "EGP")"
                                   class="form-control readonly-field currency-sold"
                                   readonly
                                   required />

                        </div>


                        <div class="col-md-3">

                            <label class="form-label">
                                Amount EGP
                            </label>

                            <input name="InvoiceLines[@i].UnitValue.AmountEGP"
                                   value="@Model.InvoiceLines[i].UnitValue?.AmountEGP"
                                   class="form-control amount-egp"
                                   type="number"
                                   step="0.00001"
                                   min="0"
                                   required />

                            <span asp-validation-for="@Model.InvoiceLines[i].UnitValue.AmountEGP"
                                  class="text-danger"></span>

                        </div>


                        <div class="col-md-3 foreign-field
                                    @(Model.InvoiceLines[i].UnitValue?.CurrencySold == "EGP"
                                                             || string.IsNullOrEmpty(Model.InvoiceLines[i].UnitValue?.CurrencySold)
                                                             ? "d-none"
                                                             : "")">

                            <label class="form-label">
                                Amount Sold
                            </label>

                            <input name="InvoiceLines[@i].UnitValue.AmountSold"
                                   value="@Model.InvoiceLines[i].UnitValue?.AmountSold"
                                   class="form-control"
                                   type="number"
                                   step="0.00001"
                                   min="0" />

                        </div>


                        <div class="col-md-3 foreign-field
                                    @(Model.InvoiceLines[i].UnitValue?.CurrencySold == "EGP"
                                                             || string.IsNullOrEmpty(Model.InvoiceLines[i].UnitValue?.CurrencySold)
                                                             ? "d-none"
                                                             : "")">

                    <label class="form-label">
                        Exchange Rate
                    </label>

                            <input name="InvoiceLines[@i].UnitValue.CurrencyExchangeRate"
                                   value="@Model.InvoiceLines[i].UnitValue?.CurrencyExchangeRate"
                                   class="form-control"
                                   type="number"
                                   step="0.00001" />

                        </div>

                    </div>

                </div>


                <!-- Discount -->
                <div class="sub-section">

                    <h6 class="sub-section-title">
                        <i class="bi bi-percent me-2"></i>
                        Line Discount
                        <span class="text-muted fw-normal">
                            (Optional)
                        </span>
                    </h6>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                Discount Rate (%)
                            </label>

                            <input name="InvoiceLines[@i].Discount.Rate"
                                   value="@Model.InvoiceLines[i].Discount?.Rate"
                                   class="form-control discount-rate"
                                   type="number"
                                   step="0.00001"
                                   min="0"
                                   max="100"
                                   placeholder="Enter discount rate" />

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Discount Amount
                            </label>

                            <input name="InvoiceLines[@i].Discount.Amount"
                                   value="@Model.InvoiceLines[i].Discount?.Amount"
                                   class="form-control discount-amount readonly-field"
                                   type="number"
                                   step="0.00001"
                                   readonly />

                            <small class="text-muted">
                                Automatically calculated.
                            </small>

                        </div>

                    </div>

                </div>


                <!-- Taxes -->
                <div class="sub-section">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h6 class="sub-section-title mb-0">

                            <i class="bi bi-percent me-2"></i>
                            Taxable Items

                        </h6>

                        <button type="button"
                                class="btn btn-sm btn-outline-primary add-tax-btn"
                                onclick="addTaxableItem(this, @i)">

                            <i class="bi bi-plus-circle me-1"></i>
                            Add Tax

                        </button>

                    </div>


                    <div class="taxes-container">

                @if (Model.InvoiceLines[i].TaxableItems != null)
                        {
                            for (int t = 0;
                            t < Model.InvoiceLines[i].TaxableItems.Count;
                            t++)
                            {
                                <div class="row g-3 tax-row">

                                    <div class="col-md-4">

                                        <label class="form-label small">
                                            Tax Type
                                        </label>

                                        <select name="InvoiceLines[@i].TaxableItems[@t].TaxType"
                                                class="form-select tax-type"
                                                required>

                                            <option value="T1"
                                                    selected="@(Model.InvoiceLines[i].TaxableItems[t].TaxType == "T1")">
                                                T1 - Value Added Tax (VAT)
                                            </option>

                                            <option value="T2"
                                                    selected="@(Model.InvoiceLines[i].TaxableItems[t].TaxType == "T2")">
                                                T2 - Table Tax (Percentage)
                                            </option>

                                            <option value="T3"
                                                    selected="@(Model.InvoiceLines[i].TaxableItems[t].TaxType == "T3")">
                                                T3 - Table Tax (Fixed Amount)
                                            </option>

                                            <option value="T4"
                                                    selected="@(Model.InvoiceLines[i].TaxableItems[t].TaxType == "T4")">
                                                T4 - Withholding Tax (WHT)
                                            </option>

                                            <option value="T5"
                                                    selected="@(Model.InvoiceLines[i].TaxableItems[t].TaxType == "T5")">
                                                T5 - Stamping Tax
                                            </option>

                                            <option value="T6"
                                                    selected="@(Model.InvoiceLines[i].TaxableItems[t].TaxType == "T6")">
                                                T6 - Health Insurance Fee
                                            </option>

                                        </select>

                                    </div>


                                    <div class="col-md-3">

                                        <label class="form-label small">
                                            Tax Rate (%)
                                        </label>

                                        <input name="InvoiceLines[@i].TaxableItems[@t].Rate"
                                               value="@Model.InvoiceLines[i].TaxableItems[t].Rate"
                                               type="number"
                                               step="0.00001"
                                               min="0"
                                               max="100"
                                               class="form-control tax-rate"
                                               required />

                                    </div>


                                    <div class="col-md-4">

                                        <label class="form-label small">
                                            Tax Amount
                                        </label>

                                        <input name="InvoiceLines[@i].TaxableItems[@t].Amount"
                                               value="@Model.InvoiceLines[i].TaxableItems[t].Amount"
                                               type="number"
                                               step="0.00001"
                                               min="0"
                                               class="form-control tax-amount readonly-field"
                                               readonly />

                                        <small class="text-muted">
                                            Automatically calculated.
                                        </small>

                                    </div>


                                    <div class="col-md-1 d-flex align-items-end">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger w-100 remove-tax"
                                                title="Remove Tax">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </div>

                                </div>
                            }
                        }

                    </div>

                </div>

            </div>
        }
    }

</div>


<!-- Add Line -->
<div class="mt-3 mb-4">

    <button type="button"
            id="addLineBtn"
            class="btn btn-outline-primary add-line-btn">

        <i class="bi bi-plus-circle me-1"></i>
        Add Invoice Line

    </button>

</div>


<script>

    let lineIndex = @(Model?.InvoiceLines?.Count ?? 0);


    // ==========================================
    // ADD INVOICE LINE
    // ==========================================

    document.getElementById("addLineBtn").addEventListener("click", function () {

        const container = document.getElementById("invoiceLinesContainer");

        const line = document.createElement("div");

        line.className = "invoice-line";

        line.innerHTML = `

            <div class="invoice-line-header">

                <h6 class="invoice-line-title">
                    <i class="bi bi-receipt me-2"></i>
                    Invoice Line
                </h6>

                <button type="button"
                        class="btn btn-sm btn-outline-danger remove-line">

                    <i class="bi bi-trash me-1"></i>
                    Remove Line

                </button>

            </div>


            <div class="row g-3">

                <div class="col-md-6">

                    <label class="form-label">
                        Description
                    </label>

                    <input
                        name="InvoiceLines[${lineIndex}].Description"
                        class="form-control"
                        required />

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Item Type
                    </label>

                    <select
                        name="InvoiceLines[${lineIndex}].ItemType"
                        class="form-select">

                        <option value="EGS">EGS</option>
                        <option value="GS1">GS1</option>

                    </select>

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Item Code
                    </label>

                    <input
                        name="InvoiceLines[${lineIndex}].ItemCode"
                        class="form-control"
                        required />

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Unit Type
                    </label>

                    <input
                        name="InvoiceLines[${lineIndex}].UnitType"
                        class="form-control"
                        required />

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Quantity
                    </label>

                    <input
                        name="InvoiceLines[${lineIndex}].Quantity"
                        type="number"
                        step="0.00001"
                        value="1"
                        min="0"
                        class="form-control quantity"
                        required />

                </div>


                <div class="col-md-6">

                    <label class="form-label">
                        Internal Code
                        <span class="text-muted">(Optional)</span>
                    </label>

                    <input
                        name="InvoiceLines[${lineIndex}].InternalCode"
                        class="form-control" />

                </div>

            </div>


            <div class="sub-section">

                <h6 class="sub-section-title">
                    <i class="bi bi-currency-exchange me-2"></i>
                    Unit Value Details
                </h6>

                <div class="row g-3">

                    <div class="col-md-3">

                        <label class="form-label">
                            Currency Sold
                        </label>

                        <input
                            name="InvoiceLines[${lineIndex}].UnitValue.CurrencySold"
                            value="EGP"
                            class="form-control readonly-field currency-sold"
                            readonly
                            required />

                    </div>


                    <div class="col-md-3">

                        <label class="form-label">
                            Amount EGP
                        </label>

                        <input
                            name="InvoiceLines[${lineIndex}].UnitValue.AmountEGP"
                            type="number"
                            step="0.00001"
                            min="0"
                            class="form-control amount-egp"
                            required />

                    </div>


                    <div class="col-md-3 foreign-field d-none">

                        <label class="form-label">
                            Amount Sold
                        </label>

                        <input
                            name="InvoiceLines[${lineIndex}].UnitValue.AmountSold"
                            type="number"
                            step="0.00001"
                            min="0"
                            class="form-control" />

                    </div>


                    <div class="col-md-3 foreign-field d-none">

                        <label class="form-label">
                            Exchange Rate
                        </label>

                        <input
                            name="InvoiceLines[${lineIndex}].UnitValue.CurrencyExchangeRate"
                            type="number"
                            step="0.00001"
                            class="form-control" />

                    </div>

                </div>

            </div>


            <div class="sub-section">

                <h6 class="sub-section-title">

                    <i class="bi bi-percent me-2"></i>
                    Line Discount
                    <span class="text-muted fw-normal">(Optional)</span>

                </h6>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Discount Rate (%)
                        </label>

                        <input
                            name="InvoiceLines[${lineIndex}].Discount.Rate"
                            type="number"
                            step="0.00001"
                            min="0"
                            max="100"
                            class="form-control discount-rate"
                            placeholder="Enter discount rate" />

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Discount Amount
                        </label>

                        <input
                            name="InvoiceLines[${lineIndex}].Discount.Amount"
                            type="number"
                            step="0.00001"
                            class="form-control discount-amount readonly-field"
                            readonly />

                        <small class="text-muted">
                            Automatically calculated.
                        </small>

                    </div>

                </div>

            </div>


            <div class="sub-section">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <h6 class="sub-section-title mb-0">

                        <i class="bi bi-percent me-2"></i>
                        Taxable Items

                    </h6>

                    <button
                        type="button"
                        class="btn btn-sm btn-outline-primary add-tax-btn"
                        onclick="addTaxableItem(this, ${lineIndex})">

                        <i class="bi bi-plus-circle me-1"></i>
                        Add Tax

                    </button>

                </div>

                <div class="taxes-container"></div>

            </div>

        `;

        container.appendChild(line);

        lineIndex++;

        attachCalculationEvents(line);

    });


    // ==========================================
    // CALCULATE DISCOUNT
    // ==========================================

    function calculateDiscount(line) {

        const quantity =
            parseFloat(line.querySelector(".quantity")?.value) || 0;

        const amountEGP =
            parseFloat(line.querySelector(".amount-egp")?.value) || 0;

        const rate =
            parseFloat(line.querySelector(".discount-rate")?.value) || 0;

        const salesTotal =
            quantity * amountEGP;

        const discountAmount =
            salesTotal * rate / 100;

        const discountInput =
            line.querySelector(".discount-amount");

        if (discountInput) {

            discountInput.value =
                discountAmount.toFixed(5);

        }

    }


    // ==========================================
    // CALCULATE TAX
    // ==========================================

    function calculateTaxes(line) {

        const quantity =
            parseFloat(line.querySelector(".quantity")?.value) || 0;

        const amountEGP =
            parseFloat(line.querySelector(".amount-egp")?.value) || 0;

        const discountRate =
            parseFloat(line.querySelector(".discount-rate")?.value) || 0;

        const salesTotal =
            quantity * amountEGP;

        const discountAmount =
            salesTotal * discountRate / 100;

        const netTotal =
            salesTotal - discountAmount;

        const taxRows =
            line.querySelectorAll(".tax-row");

        taxRows.forEach(row => {

            const taxRate =
                parseFloat(row.querySelector(".tax-rate")?.value) || 0;

            const taxAmount =
                netTotal * taxRate / 100;

            const amountInput =
                row.querySelector(".tax-amount");

            if (amountInput) {

                amountInput.value =
                    taxAmount.toFixed(5);

            }

        });

    }


    // ==========================================
    // ATTACH EVENTS
    // ==========================================

    function attachCalculationEvents(line) {

        const inputs =
            line.querySelectorAll(
                ".quantity, .amount-egp, .discount-rate"
            );

        inputs.forEach(input => {

            input.addEventListener("input", function () {

                calculateDiscount(line);
                calculateTaxes(line);

            });

        });

        line.querySelectorAll(".tax-rate")
            .forEach(input => {

                input.addEventListener("input", function () {

                    calculateTaxes(line);

                });

            });

        calculateDiscount(line);
        calculateTaxes(line);

    }


    // Existing lines

    document
        .querySelectorAll(".invoice-line")
        .forEach(line => {

            attachCalculationEvents(line);

        });


    // ==========================================
    // REMOVE LINE / TAX
    // ==========================================

    document.addEventListener("click", function (e) {

        const removeLine =
            e.target.closest(".remove-line");

        if (removeLine) {

            removeLine
                .closest(".invoice-line")
                .remove();

            reindexInvoiceLines();

            return;

        }


        const removeTax =
            e.target.closest(".remove-tax");

        if (removeTax) {

            const container =
                removeTax.closest(".taxes-container");

            removeTax
                .closest(".tax-row")
                .remove();

            reindexTaxes(container);

            const line =
                container.closest(".invoice-line");

            calculateTaxes(line);

        }

    });


    // ==========================================
    // ADD TAX
    // ==========================================

    function addTaxableItem(button, currentLineIndex) {

        const line =
            button.closest(".invoice-line");

        const taxesContainer =
            line.querySelector(".taxes-container");

        const taxIndex =
            taxesContainer.querySelectorAll(".tax-row").length;

        const taxHtml = `

            <div class="row g-3 tax-row">

                <div class="col-md-4">

                    <label class="form-label small">
                        Tax Type
                    </label>

                    <select
                        name="InvoiceLines[${currentLineIndex}].TaxableItems[${taxIndex}].TaxType"
                        class="form-select tax-type"
                        required>

                        <option value="T1">
                            T1 - Value Added Tax (VAT)
                        </option>

                        <option value="T2">
                            T2 - Table Tax (Percentage)
                        </option>

                        <option value="T3">
                            T3 - Table Tax (Fixed Amount)
                        </option>

                        <option value="T4">
                            T4 - Withholding Tax (WHT)
                        </option>

                        <option value="T5">
                            T5 - Stamping Tax
                        </option>

                        <option value="T6">
                            T6 - Health Insurance Fee
                        </option>

                    </select>

                </div>


                <div class="col-md-3">

                    <label class="form-label small">
                        Tax Rate (%)
                    </label>

                    <input
                        name="InvoiceLines[${currentLineIndex}].TaxableItems[${taxIndex}].Rate"
                        type="number"
                        step="0.00001"
                        min="0"
                        max="100"
                        class="form-control tax-rate"
                        required />

                </div>


                <div class="col-md-4">

                    <label class="form-label small">
                        Tax Amount
                    </label>

                    <input
                        name="InvoiceLines[${currentLineIndex}].TaxableItems[${taxIndex}].Amount"
                        type="number"
                        step="0.00001"
                        min="0"
                        class="form-control tax-amount readonly-field"
                        readonly />

                    <small class="text-muted">
                        Automatically calculated.
                    </small>

                </div>


                <div class="col-md-1 d-flex align-items-end">

                    <button
                        type="button"
                        class="btn btn-sm btn-outline-danger w-100 remove-tax"
                        title="Remove Tax">

                        <i class="bi bi-trash"></i>

                    </button>

                </div>

            </div>

        `;

        taxesContainer.insertAdjacentHTML(
            "beforeend",
            taxHtml
        );

        const newTaxRow =
            taxesContainer.lastElementChild;

        const taxRateInput =
            newTaxRow.querySelector(".tax-rate");

        taxRateInput.addEventListener(
            "input",
            function () {

                calculateTaxes(line);

            }
        );

        calculateTaxes(line);

    }


    // ==========================================
    // REINDEX LINES
    // ==========================================

    function reindexInvoiceLines() {

        const lines =
            document.querySelectorAll(
                "#invoiceLinesContainer .invoice-line"
            );

        lines.forEach((line, newIdx) => {

            line
                .querySelectorAll("input, select")
                .forEach(input => {

                    if (input.name) {

                        input.name =
                            input.name.replace(
                                /InvoiceLines\[\d+\]/,
                                `InvoiceLines[${newIdx}]`
                            );

                    }

                });


            const addTaxBtn =
                line.querySelector(".add-tax-btn");

            if (addTaxBtn) {

                addTaxBtn.setAttribute(
                    "onclick",
                    `addTaxableItem(this, ${newIdx})`
                );

            }

        });

        lineIndex = lines.length;

    }


    // ==========================================
    // REINDEX TAXES
    // ==========================================

    function reindexTaxes(container) {

        const rows =
            container.querySelectorAll(".tax-row");

        rows.forEach((row, newTaxIdx) => {

            row
                .querySelectorAll("input, select")
                .forEach(input => {

                    if (input.name) {

                        input.name =
                            input.name.replace(
                                /TaxableItems\[\d+\]/,
                                `TaxableItems[${newTaxIdx}]`
                            );

                    }

                });

        });

    }

</script>