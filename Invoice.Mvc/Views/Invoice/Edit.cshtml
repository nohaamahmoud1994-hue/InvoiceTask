@using Invoice.Core.Models
@model Invoices

@{
    ViewData["Title"] = "Edit Invoice";
}

<div class="container">

    <main role="main" class="pb-3">

        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h3 class="text-primary fw-bold mb-1">
                    Edit Invoice
                </h3>

                <p class="text-muted mb-0">
                    Update invoice information and details
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                ← Back to Invoices
            </a>

        </div>


        <!-- Validation Errors -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-4">

                <h6 class="fw-bold mb-2">
                    Invoice validation failed
                </h6>

                <div asp-validation-summary="All"
                     class="mb-0">
                </div>

            </div>
        }


        <form asp-action="Edit"
              method="post"
              id="editInvoiceForm">

            <!-- Important for Edit -->
            <input type="hidden"
                   asp-for="Id" />


            <!-- Tabs -->

            <ul class="nav nav-tabs mb-4"
                id="invoiceTabs"
                role="tablist">

                <!-- Invoice Info -->

                <li class="nav-item"
                    role="presentation">

                    <button class="nav-link active"
                            data-bs-toggle="tab"
                            data-bs-target="#invoice-info"
                            type="button">

                        Invoice Info

                    </button>

                </li>


                <!-- Issuer -->

                <li class="nav-item"
                    role="presentation">

                    <button class="nav-link"
                            data-bs-toggle="tab"
                            data-bs-target="#issuer"
                            type="button">

                        Issuer

                    </button>

                </li>


                <!-- Receiver -->

                <li class="nav-item"
                    role="presentation">

                    <button class="nav-link"
                            data-bs-toggle="tab"
                            data-bs-target="#receiver"
                            type="button">

                        Receiver

                    </button>

                </li>


                <!-- Invoice Lines -->

                <li class="nav-item"
                    role="presentation">

                    <button class="nav-link"
                            data-bs-toggle="tab"
                            data-bs-target="#lines"
                            type="button">

                        Invoice Lines

                    </button>

                </li>

            </ul>


            <!-- Tab Content -->

            <div class="tab-content">


                <!-- Invoice Info -->

                <div class="tab-pane fade show active"
                     id="invoice-info">

                    <partial name="_InvoiceInfo"
                             model="Model" />

                </div>


                <!-- Issuer -->

                <div class="tab-pane fade"
                     id="issuer">

                    <partial name="_Issuer"
                             model="Model" />

                </div>


                <!-- Receiver -->

                <div class="tab-pane fade"
                     id="receiver">

                    <partial name="_Receiver"
                             model="Model" />

                </div>


                <!-- Invoice Lines -->

                <div class="tab-pane fade"
                     id="lines">

                    <partial name="_InvoiceLine"
                             model="Model" />

                </div>

            </div>


            <!-- Action Buttons -->

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    Cancel

                </a>


                <button type="submit"
                        class="btn btn-primary px-4">

                    Save Changes

                </button>

            </div>

        </form>

    </main>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /*
             * Find validation summary
             */

            const validationSummary =
                document.querySelector(
                    '[data-valmsg-summary="true"]'
                );


            if (!validationSummary) {
                return;
            }


            /*
             * Get validation error text
             */

            const errorText =
                validationSummary.innerText.toLowerCase();


            /*
             * Determine which tab contains
             * the validation error
             */

            let targetTab = "invoice-info";


            // Issuer errors

            if (
                errorText.includes("issuer")
            ) {

                targetTab = "issuer";

            }


            // Receiver errors

            else if (
                errorText.includes("receiver")
            ) {

                targetTab = "receiver";

            }


            // Invoice line errors

            else if (
                errorText.includes("invoice line") ||
                errorText.includes("quantity") ||
                errorText.includes("itemcode") ||
                errorText.includes("itemtype") ||
                errorText.includes("unitvalue") ||
                errorText.includes("currency") ||
                errorText.includes("discount") ||
                errorText.includes("taxableitem") ||
                errorText.includes("taxtype") ||
                errorText.includes("tax amount") ||
                errorText.includes("tax rate")
            ) {

                targetTab = "lines";

            }


            /*
             * Activate the required tab
             */

            const tabButton =
                document.querySelector(
                    `#invoiceTabs button[data-bs-target="#${targetTab}"]`
                );


            if (tabButton) {

                const bsTab =
                    new bootstrap.Tab(tabButton);

                bsTab.show();

            }

        });

    </script>

}