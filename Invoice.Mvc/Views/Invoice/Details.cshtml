@using Invoice.Core.Models
@model Invoices

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="container">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="text-primary fw-bold mb-1">
                Invoice Details
            </h3>

            <p class="text-muted mb-0">
                View invoice information and details
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Invoices
            </a>

        </div>

    </div>


    <!-- Invoice Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">
            <h5 class="mb-0 fw-bold text-primary">
                Invoice Information
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">
                    <label class="text-muted small">
                        Document Type
                    </label>

                    <div class="fw-semibold">
                        @Model.DocumentType
                    </div>
                </div>


                <div class="col-md-4">
                    <label class="text-muted small">
                        Document Type Version
                    </label>

                    <div class="fw-semibold">
                        @Model.DocumentTypeVersion
                    </div>
                </div>


                <div class="col-md-4">
                    <label class="text-muted small">
                        Internal ID
                    </label>

                    <div class="fw-semibold">
                        @Model.InternalId
                    </div>
                </div>


                <div class="col-md-6">
                    <label class="text-muted small">
                        Taxpayer Activity Code
                    </label>

                    <div class="fw-semibold">
                        @Model.TaxpayerActivityCode
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- Issuer & Receiver -->
    <div class="row g-4 mb-4">

        <!-- Issuer -->
        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-light">
                    <h5 class="mb-0 fw-bold text-primary">
                        Issuer Information
                    </h5>
                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <label class="text-muted small">
                            Type
                        </label>

                        <div class="fw-semibold">
                            @Model.Issuer?.Type
                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="text-muted small">
                            ID
                        </label>

                        <div class="fw-semibold">
                            @Model.Issuer?.Id
                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="text-muted small">
                            Name
                        </label>

                        <div class="fw-semibold">
                            @Model.Issuer?.Name
                        </div>

                    </div>


                    <hr />

                    <h6 class="text-primary fw-bold mb-3">
                        Address
                    </h6>


                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="text-muted small">
                                Country
                            </label>

                            <div>
                                @Model.Issuer?.Address?.Country
                            </div>
                        </div>


                        <div class="col-md-6">
                            <label class="text-muted small">
                                Governate
                            </label>

                            <div>
                                @Model.Issuer?.Address?.Governate
                            </div>
                        </div>


                        <div class="col-md-6">
                            <label class="text-muted small">
                                Region / City
                            </label>

                            <div>
                                @Model.Issuer?.Address?.RegionCity
                            </div>
                        </div>


                        <div class="col-md-6">
                            <label class="text-muted small">
                                Street
                            </label>

                            <div>
                                @Model.Issuer?.Address?.Street
                            </div>
                        </div>


                        <div class="col-md-6">
                            <label class="text-muted small">
                                Building Number
                            </label>

                            <div>
                                @Model.Issuer?.Address?.BuildingNumber
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Receiver -->
        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-light">
                    <h5 class="mb-0 fw-bold text-primary">
                        Receiver Information
                    </h5>
                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <label class="text-muted small">
                            Type
                        </label>

                        <div class="fw-semibold">
                            @Model.Receiver?.Type
                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="text-muted small">
                            ID
                        </label>

                        <div class="fw-semibold">
                            @Model.Receiver?.Id
                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="text-muted small">
                            Name
                        </label>

                        <div class="fw-semibold">
                            @Model.Receiver?.Name
                        </div>

                    </div>


                    <hr />

                    <h6 class="text-primary fw-bold mb-3">
                        Address
                    </h6>


                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="text-muted small">
                                Country
                            </label>

                            <div>
                                @Model.Receiver?.Address?.Country
                            </div>
                        </div>


                        <div class="col-md-6">
                            <label class="text-muted small">
                                Governate
                            </label>

                            <div>
                                @Model.Receiver?.Address?.Governate
                            </div>
                        </div>


                        <div class="col-md-6">
                            <label class="text-muted small">
                                Region / City
                            </label>

                            <div>
                                @Model.Receiver?.Address?.RegionCity
                            </div>
                        </div>


                        <div class="col-md-6">
                            <label class="text-muted small">
                                Street
                            </label>

                            <div>
                                @Model.Receiver?.Address?.Street
                            </div>
                        </div>


                        <div class="col-md-6">
                            <label class="text-muted small">
                                Building Number
                            </label>

                            <div>
                                @Model.Receiver?.Address?.BuildingNumber
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Invoice Lines -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light d-flex justify-content-between align-items-center">

            <h5 class="mb-0 fw-bold text-primary">
                Invoice Lines
            </h5>

            <span class="badge bg-primary">
                @(Model.InvoiceLines?.Count ?? 0) Lines
            </span>

        </div>


        <div class="card-body p-0">

            @if (Model.InvoiceLines != null && Model.InvoiceLines.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>#</th>
                                <th>Description</th>
                                <th>Item Type</th>
                                <th>Item Code</th>
                                <th>Unit Type</th>
                                <th>Quantity</th>
                                <th>Unit Value</th>
                                <th>Discount</th>
                            </tr>

                        </thead>

                        <tbody>

                            @for (int i = 0; i < Model.InvoiceLines.Count; i++)
                            {
                                var line = Model.InvoiceLines[i];

                                <tr>

                                    <td>
                                        @(i + 1)
                                    </td>

                                    <td class="fw-semibold">
                                        @line.Description
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @line.ItemType
                                        </span>
                                    </td>

                                    <td>
                                        @line.ItemCode
                                    </td>

                                    <td>
                                        @line.UnitType
                                    </td>

                                    <td>
                                        @line.Quantity.ToString("N2")
                                    </td>

                                    <td>
                                        @line.UnitValue?.AmountEGP.ToString("N2") EGP
                                    </td>

                                    <td>
                                        @(line.Discount?.Amount?.ToString("N2") ?? "0.00") EGP
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    No invoice lines found.
                </div>
            }

        </div>

    </div>


    <!-- Totals -->
    <div class="row justify-content-end mb-4">

        <div class="col-md-5">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-light">
                    <h5 class="mb-0 fw-bold text-primary">
                        Invoice Summary
                    </h5>
                </div>

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">
                            Sales Total
                        </span>
                        <strong>
                            @Model.TotalSalesAmount.ToString("N2") EGP
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">
                            Total Discount
                        </span>
                        <strong>
                            @((Model.InvoiceLines?.Sum(x => x.Discount?.Amount ?? 0) ?? 0).ToString("N2")) EGP
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">
                            Net Amount
                        </span>
                        <strong>
                            @Model.NetAmount.ToString("N2") EGP
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">
                            Total Taxes
                        </span>
                        <strong>
                            @((Model.TaxTotals?.Sum(x => x.Amount) ?? 0).ToString("N2")) EGP
                        </strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">
                            Total Amount
                        </span>
                        <strong class="text-primary fs-5">
                            @Model.TotalAmount.ToString("N2") EGP
                        </strong>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Footer Buttons -->

    <div class="d-flex justify-content-end gap-2 mb-4">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary px-4">
            Edit Invoice
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-outline-danger px-4">
            Delete Invoice
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary px-4">
            Back
        </a>

    </div>

</div>